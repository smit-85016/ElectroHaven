# =============================================================================
# ElectroHaven Environment Configuration Template
# Copy this file to .env or .env.local to customize your environment settings.
# Do NOT commit your actual .env file or real secrets to version control.
# =============================================================================

# Application Metadata
VITE_APP_NAME="ElectroHaven"
VITE_APP_DESCRIPTION="Croma-Inspired Premium Electronics Storefront"
VITE_APP_VERSION="2.4.0"

# Server & Port Configuration (optional - defaults to 5173)
PORT=5173
HOST=localhost

# Optional: Google Gemini AI API Key (for external AI-powered smart setup suggestions)
# If left blank, ElectroHaven automatically uses its built-in rule-based recommendation engine.
VITE_GEMINI_API_KEY=

# Optional: External Backend / Webhook Endpoints
# ElectroHaven defaults to client-side localStorage and real-time BroadcastChannel sync.
VITE_API_BASE_URL=
VITE_ENABLE_ANALYTICS=false

# Support & Contact Information
VITE_SUPPORT_EMAIL="support@electrohaven.com"
VITE_SUPPORT_PHONE="+91 79 4000 8900"
